{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registry_id": "exomonad.event-registry",
  "version": 1,
  "schema_version": 1,
  "description": "Versioned envelope and event namespace contract for ExoMonad L1 ledger emitters.",
  "compatibility": {
    "legacy_schema_rule": "A missing schema_version means legacy input; readers preserve the row and normalize known fields without guessing identity.",
    "canonical_identifier": "event_id",
    "legacy_identifier": "id",
    "new_event_identifier_rule": "For new rows id equals event_id.",
    "reader_preference": "Readers use event_id when present and fall back to id for legacy rows.",
    "evolution_rule": "New fields are additive; existing readers must continue to accept ts, id, type, agent_id, and data."
  },
  "envelope": {
    "required_fields": [
      "schema_version",
      "event_id",
      "id",
      "event_time",
      "observed_at",
      "run_seq",
      "type",
      "agent_id",
      "run_id",
      "session_id",
      "invocation_id",
      "generation",
      "source",
      "lifecycle_state",
      "data"
    ],
    "legacy_fields": ["ts", "id", "type", "agent_id", "data"],
    "recommended_identity_fields": [
      "project_id",
      "parent_agent_id",
      "provider",
      "runtime",
      "harness",
      "role",
      "identity_confidence"
    ],
    "nullable_fields": [
      "agent_id",
      "run_id",
      "session_id",
      "invocation_id",
      "generation",
      "provider",
      "runtime",
      "harness",
      "role"
    ],
    "lifecycle_states": [
      "observed",
      "emitted",
      "delivered",
      "consumed",
      "authoritative"
    ],
    "sources": [
      "rust",
      "haskell",
      "lifecycle",
      "watcher",
      "mcp",
      "hook",
      "sqlite",
      "tl_loop",
      "custom",
      "legacy"
    ],
    "identity_confidence": ["exact", "inferred", "legacy", "unknown"]
  },
  "payload_classes": {
    "aggregate_dimensions": "Coarse dimensions that may contribute to L4 after allowlist projection.",
    "local_sensitive": "Payload or evidence that remains in local L1-L3 only.",
    "pointer_only": "A local source pointer or keyed reference without the referenced text.",
    "diagnostic_local": "Operational diagnostics that are not an analysis-grade shareable event."
  },
  "event_types": [
    {"type": "agent.spawned", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell"]},
    {"type": "agent.resumed", "payload_class": "aggregate_dimensions", "producers": ["rust", "lifecycle"]},
    {"type": "agent.harness_switch", "payload_class": "local_sensitive", "producers": ["rust", "lifecycle"]},
    {"type": "agent.stuck", "payload_class": "local_sensitive", "producers": ["rust", "haskell"]},
    {"type": "agent.notify_parent", "payload_class": "pointer_only", "producers": ["rust", "haskell"]},
    {"type": "agent.sibling_merged", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell", "watcher"]},
    {"type": "issue.closed", "payload_class": "pointer_only", "producers": ["rust", "watcher"]},
    {"type": "inbox.message", "payload_class": "local_sensitive", "producers": ["rust", "watcher"]},
    {"type": "inbox.poke", "payload_class": "aggregate_dimensions", "producers": ["rust", "watcher"]},
    {"type": "agent.completed", "payload_class": "pointer_only", "producers": ["haskell"]},
    {"type": "agent.stop_check", "payload_class": "aggregate_dimensions", "producers": ["haskell"]},
    {"type": "agent.invocation.started", "payload_class": "aggregate_dimensions", "producers": ["lifecycle"]},
    {"type": "agent.invocation.finished", "payload_class": "aggregate_dimensions", "producers": ["lifecycle"]},
    {"type": "agent.task_budget_exceeded", "payload_class": "aggregate_dimensions", "producers": ["tl_loop", "lifecycle"]},
    {"type": "agent.guidance.delivery", "payload_class": "aggregate_dimensions", "producers": ["lifecycle", "rust"]},
    {"type": "tl.phase_changed", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.slice_status_changed", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.slice_parked", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.slice_abandoned", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.gate_opened", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.gate_answered", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.merge_decided", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.judgment", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "tl.plan_proposed", "payload_class": "aggregate_dimensions", "producers": ["tl_loop"]},
    {"type": "pr.filed", "payload_class": "pointer_only", "producers": ["rust", "haskell"]},
    {"type": "pr.updated", "payload_class": "pointer_only", "producers": ["rust", "haskell"]},
    {"type": "pr.published", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell"]},
    {"type": "pr.replaced", "payload_class": "local_sensitive", "producers": ["rust", "haskell"]},
    {"type": "pr.merge_requested", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell"]},
    {"type": "pr.merged", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell", "watcher"]},
    {"type": "pr.merge_failed", "payload_class": "pointer_only", "producers": ["rust", "haskell"]},
    {"type": "pr.review", "payload_class": "local_sensitive", "producers": ["watcher", "rust"]},
    {"type": "copilot.review", "payload_class": "local_sensitive", "producers": ["watcher"]},
    {"type": "ci.status_changed", "payload_class": "aggregate_dimensions", "producers": ["watcher"]},
    {"type": "event.dispatched", "payload_class": "aggregate_dimensions", "producers": ["watcher", "haskell"]},
    {"type": "event.dispatch_failed", "payload_class": "pointer_only", "producers": ["watcher", "haskell"]},
    {"type": "watcher.poll_cycle", "payload_class": "aggregate_dimensions", "producers": ["watcher"]},
    {"type": "watcher.pr_observation", "payload_class": "aggregate_dimensions", "producers": ["watcher"]},
    {"type": "hook.stop", "payload_class": "aggregate_dimensions", "producers": ["hook", "rust"]},
    {"type": "tool.called", "payload_class": "aggregate_dimensions", "producers": ["rust", "haskell"]},
    {"type": "message.delivery", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "message.consumed", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "agent.message_sent", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "agent_inbox.duplicates_dropped", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "agent_inbox.messages_abandoned", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "session.state_changed", "payload_class": "pointer_only", "producers": ["rust", "lifecycle"]},
    {"type": "memory.state_changed", "payload_class": "pointer_only", "producers": ["rust", "sqlite"]},
    {"type": "inbox.state_changed", "payload_class": "aggregate_dimensions", "producers": ["rust", "sqlite"]},
    {"type": "event.superseded", "payload_class": "pointer_only", "producers": ["rust", "sqlite"]},
    {"type": "ledger.segment.dropped", "payload_class": "aggregate_dimensions", "producers": ["rust"]},
    {"type": "sink.health", "payload_class": "aggregate_dimensions", "producers": ["rust", "sqlite"]},
    {"type": "custom", "payload_class": "local_sensitive", "producers": ["custom", "haskell"]}
  ],
  "dynamic_event_rule": {
    "allowed_namespace": "custom.",
    "default_payload_class": "local_sensitive",
    "requires_declared_producer": true,
    "requires_same_envelope_checks": true
  },
  "trace_span_names": [
    "exomonad.serve",
    "agent_request",
    "mcp_stdio.request",
    "host_function",
    "worktree_event_watcher.poll_cycle",
    "github_poller.poll_cycle"
  ]
}
